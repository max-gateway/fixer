# IP da máquina na rede (celular). Remova para usar localhost.
DEV_HOST=192.168.0.14

# Caminho do clone de github.com/max-gateway/platform (serviços compartilhados: plate-lookup, cnpj-lookup,
# plate-reader). Usado pelo infra/dev/docker-compose.yml. Os segredos de cada serviço ficam no .env dele, lá.
MAX_GATEWAY_PLATFORM_DIR=C:/Users/gusta/Documents/Projetos/max-gateway/platform

# Importação de NF-e (docs/specs/nfe-import.md): chave mestra que cifra o certificado A1 no banco.
# Sem estas duas variáveis a API sobe normalmente e a área fiscal responde "indisponível".
# Gerar a chave:  node -e "console.log(JSON.stringify({k1: require('crypto').randomBytes(32).toString('base64')}))"
# FISCAL_ENC_KEYS={"k1":"<base64 de 32 bytes>"}
# FISCAL_ACTIVE_KEY_ID=k1
#
# Sincronização com a SEFAZ (NFeDistribuicaoDFe). Sem URL para o ambiente do certificado, a rodada falha
# com "URL não configurada" e tenta de novo com backoff. Endereços: Portal Nacional da NF-e > Serviços >
# Relação de Serviços Web (homologação no portal de homologação). Conferir antes de usar.
# FISCAL_DIST_URL_HOMOLOGATION=https://hom1.nfe.fazenda.gov.br/NFeDistribuicaoDFe/NFeDistribuicaoDFe.asmx
# FISCAL_DIST_URL_PRODUCTION=https://www1.nfe.fazenda.gov.br/NFeDistribuicaoDFe/NFeDistribuicaoDFe.asmx
# Cadeia ICP-Brasil dos servidores da SEFAZ (PEM). O Node não a traz; a verificação do servidor nunca é desligada.
# Manifestação do destinatário (NFeRecepcaoEvento, Ambiente Nacional). Mesma fonte: Relação de Serviços Web.
# FISCAL_EVENT_URL_HOMOLOGATION=https://hom1.nfe.fazenda.gov.br/NFeRecepcaoEvento4/NFeRecepcaoEvento4.asmx
# FISCAL_EVENT_URL_PRODUCTION=https://www.nfe.fazenda.gov.br/NFeRecepcaoEvento4/NFeRecepcaoEvento4.asmx
# FISCAL_EVENT_SOAP=1.2   # ou 1.1, conforme o WSDL do ambiente
# FISCAL_CA_BUNDLE=/caminho/para/icp-brasil-chain.pem
# FISCAL_SYNC_ENABLED=false   # desliga o loop (ex.: réplica que não deve consultar)
