# @max-gateway/* vem do registro de pacotes da organização. O token nunca é gravado: vem de NODE_AUTH_TOKEN
# (CI: GITHUB_TOKEN; local: `export NODE_AUTH_TOKEN=$(gh auth token)` com o escopo read:packages).
@max-gateway:registry=https://npm.pkg.github.com
//npm.pkg.github.com/:_authToken=${NODE_AUTH_TOKEN}
