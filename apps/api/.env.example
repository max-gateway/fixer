# Obrigatórias (validadas na subida): DATABASE_URL, KEYCLOAK_AUTH_SERVER_URL, KEYCLOAK_REALM, AUTH_AUDIENCE, PARTS_SEARCH_URL.
#
# --- Identidade (@max-gateway/auth; docs/specs/parts-search-integration.md §4) -------------------------
# AUTH_AUDIENCE=fixer-api   # `aud` que o token precisa trazer. O client web tem um audience mapper para ela (infra/dev/realm-fixer-dev.json);
#                           # realm criado antes do mapper precisa dele (ou reimportar o realm). Token vive no máximo 15 min e traz `iat`.
# PARTS_SEARCH_URL=http://localhost:3500   # túnel: ssh -N -L 3500:127.0.0.1:3500 ubuntu@rocket-oracle-vps
# PARTS_SEARCH_TIMEOUT_MS=2000              # tempo limite de cada chamada à plataforma (padrão 2 s)
# PARTS_SEARCH_CATALOGS=rocket-autopecas   # catálogos globais da plataforma que as oficinas leem (vírgula)
#
# --- Multi-tenant (docs/specs/multi-tenancy.md) ---------------------------------------------------------
# DATABASE_URL deve usar um papel SEM bypass de RLS (fixer_rls; ver infra/dev/rls-roles.sql). Um superusuário ignora
# a RLS e anularia o isolamento entre organizações.
# SYSTEM_DATABASE_URL=postgresql://fixer_system:password@localhost:5432/fixer   # papel com BYPASSRLS: relay da outbox, agendadores, portal
# A organização vem da participação registrada pelos eventos do control plane (OrgMembership), NUNCA do claim do token (o claim
# `organization` é só uma pista: o Keycloak 26.0 o omite ao acaso). O login web pede organization:* (apps/web: KEYCLOAK_ORGANIZATIONS=true).
# Não existe mais organização padrão de instalação legada (DEFAULT_ORG_ID) nem claim configurável (AUTH_ORGS_CLAIM).
#
# --- Control plane da Max Gateway (provisionamento e licença por evento). Desligado se faltar qualquer uma das três ---
# CONTROL_PLANE_URL=http://localhost:3400
# CONTROL_PLANE_API_KEY=cp_xxxxxxxxxxxx.yyyy   # chave com escopo "product" (node dist/cli.js create-key product fixer)
# RABBITMQ_URL=amqp://guest:guest@localhost:5672
# LICENSE_REQUIRED=true           # produção compartilhada: organização sem licença conhecida fica sem acesso
# CONTROL_PLANE_PRODUCT=fixer     # chave do produto no catálogo do control plane (padrão fixer)
# CONTROL_PLANE_USAGE_INTERVAL_MS=900000   # de quanto em quanto tempo informar o consumo ao control plane (padrão 15 min)
#
# --- Controle de acesso (Configurações → Acessos; src/access/README.md) ---------------------------------
# Client confidencial do Keycloak com service account (view-users, manage-users e, no modo organization, manage-realm).
# Sem ele a tela funciona só com quem já entrou (papéis, ativar/desativar), sem convites. Crie com:
#   node scripts/keycloak-access-client.mjs --realm fixer-dev
# KEYCLOAK_ADMIN_CLIENT_ID=fixer-access
# KEYCLOAK_ADMIN_CLIENT_SECRET=...
# ACCESS_DIRECTORY_MODE=organization        # organization (realm único com Organizations) | realm (instalação dedicada)
# ACCESS_INVITE_REDIRECT_URI=http://localhost:3001   # para onde o link do e-mail de convite leva depois de definir a senha
# ACCESS_INVITE_LIFESPAN_SECONDS=259200     # validade do link do convite (padrão 72 h)
# Copie para .env (em produção vem do ConfigMap/Secret do chart fixer-tenant)
# Keycloak do infra/dev/docker-compose.yml (porta 8180)
KEYCLOAK_AUTH_SERVER_URL=https://id.maxgateway.com.br
KEYCLOAK_REALM=maxgateway
# Postgres do infra/dev/docker-compose.yml (npm run infra:up na raiz)
DATABASE_URL="postgresql://fixer_app:password@localhost:5432/fixer"

# Serviço plate-lookup (max-gateway/platform) (chama a Puxa Placa real; precisa de PLATE_LOOKUP_PUXA_PLACA_TOKEN lá)
# PLATE_LOOKUP_SERVICE_URL=http://localhost:8081

# Serviço cnpj-lookup (max-gateway/platform) (consulta CNPJ + IE no CNPJá; precisa de CNPJ_LOOKUP_CNPJA_API_KEY lá)
# CNPJ_LOOKUP_SERVICE_URL=http://localhost:8082

# Serviço cost-engine (max-gateway/platform): despesas, rateio e perfil de custos (aba Precificação → Despesas).
# Sem as duas variáveis a aba mostra "motor desligado" e o resto do Fixer funciona igual. A chave sai do
# `npm run cli -- create-key fixer:<instalação>` do cost-engine; uma chave por instalação do Fixer.
# COST_ENGINE_URL=http://localhost:3030
# COST_ENGINE_API_KEY=ce_xxxxxxxxxxxx.segredo

# Vínculo OS <-> WhatsApp. Número da oficina (o mesmo do META_PHONE_NUMBER_ID), só dígitos com DDI: sem ele
# o portal não mostra o botão "Falar com a oficina".
# WHATSAPP_BUSINESS_PHONE=5511999999999
# Stream por onde o apps/whatsapp avisa que um cliente mandou o código da OS (precisa do mesmo REDIS_URL).
# WHATSAPP_INBOUND_STREAM=fixer:whatsapp-inbound
# WHATSAPP_INBOUND_ENABLED=true
# TENANT_SLUG=local             # eventos de outro tenant vão para a DLQ

# Porta da API (padrao 3000). Se mudar, ajuste NEXT_PUBLIC_API_URL no apps/web/.env.local.
# PORT=3000

# --- Importação de NF-e pelo dfe-gateway (recomendado) ---------------------------------------------------
# O certificado A1 e a consulta à SEFAZ ficam no gateway central; este tenant só consome. Com as duas variáveis
# definidas, FISCAL_ENC_KEYS e FISCAL_DIST_URL_* deixam de ser usadas. Peça a chave a quem opera o gateway:
#   docker exec dfe_api node dist/cli.js key:create <slug-do-tenant>
# DFE_GATEWAY_URL=https://dfe.maxgateway.com.br
# DFE_GATEWAY_API_KEY=dfe_xxxxxxxxxxxx.yyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyy
# DFE_GATEWAY_POLL_MS=60000

# Integra Contador (SERPRO), via servico de plataforma `integra-contador` (docs/specs/integra-contador.md).
# Sem a URL a consulta a Receita fica desligada e o RBT12 vem da estimativa pelas ordens de servico.
# A oficina assina o termo de autorizacao no dfe-gateway (modo gateway); sem DFE_GATEWAY_URL nao ha quem assine.
# INTEGRA_CONTADOR_URL=http://localhost:8083
# INTEGRA_CONTADOR_API_KEY=
