# Obrigatórias (validadas na subida): DATABASE_URL, KEYCLOAK_AUTH_SERVER_URL, KEYCLOAK_REALM.
# Copie para .env (em produção vem do ConfigMap/Secret do chart fixer-tenant)
# Keycloak do infra/dev/docker-compose.yml (porta 8180)
KEYCLOAK_AUTH_SERVER_URL=http://localhost:8180
KEYCLOAK_REALM=fixer-dev
# Postgres do infra/dev/docker-compose.yml (npm run infra:up na raiz)
DATABASE_URL="postgresql://fixer_app:password@localhost:5432/fixer"

# Microservice apps/plate-lookup (chama a Puxa Placa real; precisa de PLATE_LOOKUP_PUXA_PLACA_TOKEN lá)
# PLATE_LOOKUP_SERVICE_URL=http://localhost:8081

# Microservice apps/cnpj-lookup (consulta CNPJ + IE no CNPJá; precisa de CNPJ_LOOKUP_CNPJA_API_KEY lá)
# CNPJ_LOOKUP_SERVICE_URL=http://localhost:8082

# Vínculo OS <-> WhatsApp. Número da oficina (o mesmo do META_PHONE_NUMBER_ID), só dígitos com DDI: sem ele
# o portal não mostra o botão "Falar com a oficina".
# WHATSAPP_BUSINESS_PHONE=5511999999999
# Stream por onde o apps/whatsapp avisa que um cliente mandou o código da OS (precisa do mesmo REDIS_URL).
# WHATSAPP_INBOUND_STREAM=fixer:whatsapp-inbound
# WHATSAPP_INBOUND_ENABLED=true
# TENANT_SLUG=local             # eventos de outro tenant vão para a DLQ

# Porta da API (padrao 3000). Se mudar, ajuste NEXT_PUBLIC_API_URL no apps/web/.env.local.
# PORT=3000

# --- Importação de NF-e pelo dfe-gateway (recomendado) ---------------------------------------------------
# O certificado A1 e a consulta à SEFAZ ficam no gateway central; este tenant só consome. Com as duas variáveis
# definidas, FISCAL_ENC_KEYS e FISCAL_DIST_URL_* deixam de ser usadas. Peça a chave a quem opera o gateway:
#   docker exec dfe_api node dist/cli.js key:create <slug-do-tenant>
# DFE_GATEWAY_URL=https://dfe.maxgateway.com.br
# DFE_GATEWAY_API_KEY=dfe_xxxxxxxxxxxx.yyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyy
# DFE_GATEWAY_POLL_MS=60000
