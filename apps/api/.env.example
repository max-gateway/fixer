# Obrigatórias (validadas na subida): DATABASE_URL, KEYCLOAK_AUTH_SERVER_URL, KEYCLOAK_REALM.
#
# --- Multi-tenant (docs/specs/multi-tenancy.md) ---------------------------------------------------------
# DATABASE_URL deve usar um papel SEM bypass de RLS (fixer_rls; ver infra/dev/rls-roles.sql). Um superusuário ignora
# a RLS e anularia o isolamento entre organizações.
# SYSTEM_DATABASE_URL=postgresql://fixer_system:password@localhost:5432/fixer   # papel com BYPASSRLS: relay da outbox, agendadores, portal
# AUTH_ORGS_CLAIM=organization    # claim do token com as organizações do usuário (padrão: o do Keycloak Organizations; UUIDs do control plane)
#                                 # o claim é só um atalho (o Keycloak 26.0 o omite ao acaso para quem está em várias oficinas): a participação
#                                 # vem dos eventos do control plane. O login web pede organization:* (apps/web: KEYCLOAK_ORGANIZATIONS=true)
# DEFAULT_ORG_ID=<uuid>           # SÓ instalação legada (um banco por oficina): organização assumida quando o token não traz o claim
#
# --- Control plane da Max Gateway (provisionamento e licença por evento). Desligado se faltar qualquer uma das três ---
# CONTROL_PLANE_URL=http://localhost:3400
# CONTROL_PLANE_API_KEY=cp_xxxxxxxxxxxx.yyyy   # chave com escopo "product" (node dist/cli.js create-key product fixer)
# RABBITMQ_URL=amqp://guest:guest@localhost:5672
# LICENSE_REQUIRED=true           # produção compartilhada: organização sem licença conhecida fica sem acesso
# CONTROL_PLANE_PRODUCT=fixer     # chave do produto no catálogo do control plane (padrão fixer)
# CONTROL_PLANE_USAGE_INTERVAL_MS=900000   # de quanto em quanto tempo informar o consumo ao control plane (padrão 15 min)
# Copie para .env (em produção vem do ConfigMap/Secret do chart fixer-tenant)
# Keycloak do infra/dev/docker-compose.yml (porta 8180)
KEYCLOAK_AUTH_SERVER_URL=http://localhost:8180
KEYCLOAK_REALM=fixer-dev
# Postgres do infra/dev/docker-compose.yml (npm run infra:up na raiz)
DATABASE_URL="postgresql://fixer_app:password@localhost:5432/fixer"

# Serviço plate-lookup (max-gateway/platform) (chama a Puxa Placa real; precisa de PLATE_LOOKUP_PUXA_PLACA_TOKEN lá)
# PLATE_LOOKUP_SERVICE_URL=http://localhost:8081

# Serviço cnpj-lookup (max-gateway/platform) (consulta CNPJ + IE no CNPJá; precisa de CNPJ_LOOKUP_CNPJA_API_KEY lá)
# CNPJ_LOOKUP_SERVICE_URL=http://localhost:8082

# Vínculo OS <-> WhatsApp. Número da oficina (o mesmo do META_PHONE_NUMBER_ID), só dígitos com DDI: sem ele
# o portal não mostra o botão "Falar com a oficina".
# WHATSAPP_BUSINESS_PHONE=5511999999999
# Stream por onde o apps/whatsapp avisa que um cliente mandou o código da OS (precisa do mesmo REDIS_URL).
# WHATSAPP_INBOUND_STREAM=fixer:whatsapp-inbound
# WHATSAPP_INBOUND_ENABLED=true
# TENANT_SLUG=local             # eventos de outro tenant vão para a DLQ

# Porta da API (padrao 3000). Se mudar, ajuste NEXT_PUBLIC_API_URL no apps/web/.env.local.
# PORT=3000

# --- Importação de NF-e pelo dfe-gateway (recomendado) ---------------------------------------------------
# O certificado A1 e a consulta à SEFAZ ficam no gateway central; este tenant só consome. Com as duas variáveis
# definidas, FISCAL_ENC_KEYS e FISCAL_DIST_URL_* deixam de ser usadas. Peça a chave a quem opera o gateway:
#   docker exec dfe_api node dist/cli.js key:create <slug-do-tenant>
# DFE_GATEWAY_URL=https://dfe.maxgateway.com.br
# DFE_GATEWAY_API_KEY=dfe_xxxxxxxxxxxx.yyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyy
# DFE_GATEWAY_POLL_MS=60000
