# Copie para deploy/.env (NÃO versionar) e preencha. Gere segredos na própria VM:
#   openssl rand -base64 32   # chave mestra (DFE_ENC_KEYS) e senha do banco
#
# A senha do banco vai em deploy/secrets/db_password (um arquivo, chmod 600) E dentro de DFE_DATABASE_URL.

# --- Banco (só dfe_net) ---
DFE_DATABASE_URL=postgresql://dfe:TROQUE_PELA_SENHA@dfe-postgres:5432/dfe

# --- Chave mestra que embrulha os certificados (spec §9). NUNCA perca: sem ela os .pfx não abrem. ---
# Guarde uma cópia FORA da VM (cofre de senhas). Rotação: adicione "k2", ative, rode a re-embrulha.
DFE_ENC_KEYS={"k1":"TROQUE_POR_32_BYTES_EM_BASE64"}
DFE_ACTIVE_KEY_ID=k1

# --- SEFAZ (Ambiente Nacional). Conferir na "Relação de Serviços Web" do Portal Nacional da NF-e. ---
DFE_DIST_URL_PRODUCTION=https://www1.nfe.fazenda.gov.br/NFeDistribuicaoDFe/NFeDistribuicaoDFe.asmx
DFE_DIST_URL_HOMOLOGATION=https://hom1.nfe.fazenda.gov.br/NFeDistribuicaoDFe/NFeDistribuicaoDFe.asmx
DFE_EVENT_URL_PRODUCTION=https://www1.nfe.fazenda.gov.br/NFeRecepcaoEvento4/NFeRecepcaoEvento4.asmx
DFE_EVENT_URL_HOMOLOGATION=https://hom1.nfe.fazenda.gov.br/NFeRecepcaoEvento4/NFeRecepcaoEvento4.asmx
# DFE_EVENT_SOAP=1.2   # mesmo formato que o rocket já usa em produção
# DFE_CA_BUNDLE=/run/secrets/icp-brasil.pem   # cadeia ICP-Brasil, se a TLS da SEFAZ falhar

# --- Sincronização ---
DFE_TICK_MS=30000
DFE_CONCURRENCY=8

# --- Aviso por RabbitMQ (rocket): mesmo broker do rocket, via rocket_prod_network ---
RABBITMQ_URL=amqp://rabbitmq:5672   # o mesmo valor de RABBITMQ_URL do backend do rocket
RABBITMQ_EXCHANGE=dfe.documents

# --- Redis Streams (só para consumidor na MESMA rede; tenants Fixer na AWS usam WEBHOOK) ---
# REDIS_URL=

# NUNCA em produção:
# DFE_ALLOW_INSECURE_WEBHOOKS=true
