# Copie para .env (em produção vem do ConfigMap/Secret do chart fixer-tenant)
PORT=3005
# Banco próprio do serviço (pode ser o mesmo servidor Postgres; as tabelas ficam no schema "notifications")
NOTIFICATIONS_DATABASE_URL="postgresql://fixer_app:password@localhost:5432/fixer"
REDIS_URL=redis://localhost:6379/0
ORDER_EVENTS_STREAM=fixer:order-events

# Keycloak do tenant (valida o JWT das rotas /v1 usadas pelo frontend)
KEYCLOAK_AUTH_SERVER_URL=http://localhost:8180
KEYCLOAK_REALM=fixer-dev

TENANT_DISPLAY_NAME=Fixer
BRAND_PRIMARY_COLOR=#3346C2

# "log" só escreve no log (dev); "smtp" envia de verdade.
EMAIL_TRANSPORT=log
EMAIL_FROM="Fixer <no-reply@fixer.local>"
# SMTP_URL=smtps://user:pass@smtp.example.com:465

# Webhooks assinados (HMAC-SHA256). "events" aceita curingas: ["order.*"] ou ["order.status_changed"].
# WEBHOOKS='[{"url":"https://example.com/hook","secret":"troque-me","events":["order.*"]}]'

# Canal WhatsApp (serviço apps/whatsapp). Defina as duas ou nenhuma; sem elas o canal fica desligado.
# WHATSAPP_SERVICE_URL=http://localhost:3006
# WHATSAPP_API_KEY=<uma das WHATSAPP_API_KEYS do serviço>
