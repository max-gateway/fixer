# Runtime config (em produção vem do ConfigMap/Secret do chart fixer-tenant)
NEXT_PUBLIC_API_URL=http://localhost:3000
# Serviço de notificações (apps/notifications); o navegador acessa via proxy /api/notifications.
NOTIFICATIONS_URL=http://localhost:3005
KEYCLOAK_AUTH_SERVER_URL=http://localhost:8080
KEYCLOAK_REALM=fixer-dev
KEYCLOAK_WEB_CLIENT_ID=fixer-web
KEYCLOAK_WEB_CLIENT_SECRET=change-me
# gere com: npx auth secret
AUTH_SECRET=change-me
AUTH_URL=http://localhost:3001

# Base pública do link do portal do cliente (/o/<token>). Em dev, usa o host da requisição.
# PORTAL_PUBLIC_URL=https://minhaoficina.fixer.com.br
# Multi-tenant: só com o recurso Organizations ligado no realm (scripts/keycloak-setup-realm.mjs, em max-gateway/platform).
# Faz o login pedir `organization:*`, sem o que quem participa de mais de uma organização fica sem o claim no token.
# KEYCLOAK_ORGANIZATIONS=true
