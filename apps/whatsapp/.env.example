# Copie para .env (em produção vem do ConfigMap/Secret do chart fixer-tenant)
PORT=3006
# Banco próprio do serviço (pode ser o mesmo servidor Postgres; as tabelas ficam no schema "whatsapp")
WHATSAPP_DATABASE_URL="postgresql://fixer_app:password@localhost:5432/fixer"

# Chaves de quem pode enviar (apps/api, apps/notifications), separadas por vírgula. Gere com: openssl rand -hex 32
WHATSAPP_API_KEYS=dev-key-troque-me-12345678

# "log" só escreve no log (dev, sem Meta); "cloud" envia pela WhatsApp Cloud API.
WHATSAPP_PROVIDER=log
# --- obrigatórios com WHATSAPP_PROVIDER=cloud ---
# META_ACCESS_TOKEN=            # token permanente de System User (nunca o token temporário de 24h)
# META_PHONE_NUMBER_ID=
# META_APP_SECRET=              # valida a assinatura X-Hub-Signature-256 dos webhooks
# META_WEBHOOK_VERIFY_TOKEN=    # o mesmo que você cadastra no painel da Meta
# META_GRAPH_VERSION=v21.0
# META_MAX_MPS=20               # mensagens/segundo (o limite da Meta é 80 por número)

# --- vínculo OS <-> WhatsApp (código recebido vira evento para a API via Redis Stream) ---
# Sem REDIS_URL os eventos ficam no outbox (tabela event_outbox) e não chegam à API.
# REDIS_URL=redis://localhost:6379/0
# TENANT_SLUG=local
# INBOUND_EVENTS_STREAM=fixer:whatsapp-inbound
# ORDER_CODE_MAX_PER_WINDOW=5     # tentativas de código por remetente...
# ORDER_CODE_WINDOW_MS=600000     # ...nesta janela (10 min)
