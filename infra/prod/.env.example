# Ambiente de TESTE online do Fixer (VPS, Docker Compose). Copie para infra/prod/.env (ignorado pelo git) e preencha.
# Nunca reaproveite aqui segredos do ambiente de dev nem dados reais de clientes.

# --- Host público (só o web; a API fica interna) ---------------------------------------------------------
# Domínio provisório, sem https:// e sem barra. O DNS (registro A) aponta para o IP público da mg-platform (o mesmo de id./catalog./dfe.).
FIXER_HOST=fixer.maxgateway.com.br

# --- Banco (gere cada senha: openssl rand -base64 24 | tr -d '/+=') ---------------------------------------
POSTGRES_OWNER_PASSWORD=
FIXER_RLS_PASSWORD=
FIXER_SYSTEM_PASSWORD=

# --- Identidade (Keycloak da plataforma, realm único com Organizations) -----------------------------------
KEYCLOAK_AUTH_SERVER_URL=https://id.maxgateway.com.br
KEYCLOAK_REALM=maxgateway
# Segredo do client confidencial `fixer-web`: o MESMO valor de KC_SECRET_FIXER_WEB na plataforma (ver README).
KEYCLOAK_WEB_CLIENT_SECRET=
# Sessão do Auth.js: openssl rand -base64 32
AUTH_SECRET=

# --- Catálogo e tenant ------------------------------------------------------------------------------------
PARTS_SEARCH_URL=https://catalog.maxgateway.com.br
PARTS_SEARCH_CATALOGS=rocket-autopecas
TENANT_SLUG=teste

# --- Control plane (participação em organizações e licença) ----------------------------------------------
# Rodando na mg-platform, ambos são alcançados pelo nome na rede `platform_net` (não são públicos).
# CONTROL_PLANE_API_KEY: docker exec mg_control_plane node dist/cli.js create-key product fixer-teste fixer   (rótulo, produto: a chave fica presa ao produto)
# RABBITMQ_URL: usuário `fixer-svc` do vhost `mg` (criado no platform-broker/setup.sh; ver README, passo 1).
CONTROL_PLANE_URL=http://mg_control_plane:3400
CONTROL_PLANE_API_KEY=
RABBITMQ_URL=amqp://fixer-svc:CHANGE-ME@mg_rabbitmq:5672/mg
LICENSE_REQUIRED=false

# --- Equipe (workforce da plataforma, rede interna; services/workforce/deploy no repo da plataforma) ----------------
WORKFORCE_URL=http://workforce:3600

# --- NF-e pelo dfe-gateway (opcional no teste) ------------------------------------------------------------
DFE_GATEWAY_URL=https://dfe.maxgateway.com.br
DFE_GATEWAY_API_KEY=

# --- Convites de acesso (opcional; node scripts/keycloak-access-client.mjs) ------------------------------
KEYCLOAK_ADMIN_CLIENT_ID=
KEYCLOAK_ADMIN_CLIENT_SECRET=
