{
  "name": "fixer",
  "private": true,
  "packageManager": "npm@11.19.1",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "infra:up": "docker compose -f infra/dev/docker-compose.yml up -d --build --wait",
    "infra:down": "docker compose -f infra/dev/docker-compose.yml down",
    "infra:logs": "docker compose -f infra/dev/docker-compose.yml logs -f --tail=100",
    "infra:ps": "docker compose -f infra/dev/docker-compose.yml ps",
    "dev": "npm run infra:up && turbo run dev --filter=@fixer/api --filter=@fixer/web",
    "dev:all": "npm run infra:up && turbo run dev --continue",
    "tunnel": "ngrok http --url=unturpentined-lichtly-delena.ngrok-free.dev 3001",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "turbo": "^2.1.0",
    "typescript": "^5.6.0"
  }
}
