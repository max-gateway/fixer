// Fixer — schema Prisma (multi-tenant: um banco compartilhado, isolamento por organização)
//
// Toda tabela de dados de uma oficina tem `orgId` (UUID da organização no control plane da Max Gateway),
// preenchido pelo banco a partir de `app.org_id` da sessão (função app_org()) e protegido por Row Level Security:
// uma consulta só enxerga as linhas da organização da requisição, e sem organização não enxerga nada.
// Tabelas SEM orgId são referência compartilhada (Permission, PlateLookup, catálogo e variantes de veículo).
// Ver docs/specs/multi-tenancy.md.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// Users & Roles (identity mirrors Keycloak; Keycloak is source of truth)
// ============================================================

model User {
  id         String   @id @default(cuid())
  orgId      String   @default(dbgenerated("app_org()")) @db.Uuid
  keycloakId String // "sub" claim from the tenant's Keycloak realm
  name       String
  email      String
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  roles                     UserRole[]
  createdServiceOrders      ServiceOrder[]          @relation("ServiceOrderCreatedBy")
  assignedServiceOrders     ServiceOrder[]          @relation("ServiceOrderAssignedTo")
  statusChanges             ServiceOrderStatusLog[]
  stockMovements            StockMovement[]
  fiscalCredentialsUploaded FiscalCredential[]      @relation("FiscalUploadedBy")
  fiscalAutoExports         FiscalCredential[]      @relation("FiscalAutoExportBy")
  postedInvoices            PurchaseInvoice[]       @relation("InvoicePostedBy")
  paidPayables              Payable[]               @relation("PayablePaidBy")
  fiscalAuditLogs           FiscalAuditLog[]

  @@unique([orgId, keycloakId])
  @@unique([orgId, email])
  @@index([orgId])
}

model Role {
  id          String   @id @default(cuid())
  orgId       String   @default(dbgenerated("app_org()")) @db.Uuid
  name        String // e.g. "Admin", "Front desk", "Lead mechanic"
  description String?
  isSystem    Boolean  @default(false) // seeded on tenant provisioning, not deletable
  createdAt   DateTime @default(now())

  permissions RolePermission[]
  users       UserRole[]

  @@unique([orgId, name])
  @@index([orgId])
}

model Permission {
  id    String @id @default(cuid())
  key   String @unique // e.g. "service_order.create", "stock.adjust", "finance.view"
  label String // human-readable label for the role management UI

  roles RolePermission[]
}

model RolePermission {
  orgId        String     @default(dbgenerated("app_org()")) @db.Uuid
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([orgId])
}

model UserRole {
  orgId  String @default(dbgenerated("app_org()")) @db.Uuid
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([orgId])
}

// ============================================================
// Plate lookups (Puxa Placa)
// ============================================================

// Histórico de consultas de placa feitas na API Puxa Placa, via o
// microservice apps/plate-lookup (Python). Uma placa só é consultada na API
// externa (paga) uma vez: antes de chamar o microservice, a aplicação checa
// se já existe um registro aqui para a placa e, se sim, reaproveita `rawResponse`
// em vez de gerar uma nova chamada. Ver apps/api/src/plate-lookup/README.md.
model PlateLookup {
  id          String   @id @default(cuid())
  plate       String   @unique
  rawResponse Json // JSON cru devolvido pela Puxa Placa, sem filtrar campos (leitura tipada em apps/api/src/plate-lookup/schema.ts)
  brand       String? // extraído de rawResponse.basico.dados.marca, para consulta/index sem parsear o JSON
  model       String? // extraído de rawResponse.basico.dados.modelo
  year        Int? // extraído de rawResponse.basico.dados.ano
  queriedAt   DateTime @default(now())
}

// ============================================================
// Customers & Vehicles
// ============================================================

model Customer {
  id       String  @id @default(cuid())
  orgId    String  @default(dbgenerated("app_org()")) @db.Uuid
  name     String
  document String? // CPF/CNPJ; null = cadastro pendente (OS aberta só com o telefone, o cliente completa no portal)
  phone    String?
  email    String?

  // Endereço — preenchido pelo próprio cliente no portal da ordem de serviço.
  zipCode    String?
  street     String?
  number     String?
  complement String?
  district   String?
  city       String?
  state      String?

  // Dados de PJ vindos da consulta de CNPJ (apps/cnpj-lookup) no cadastro.
  tradeName               String? // nome fantasia
  stateRegistration       String? // Inscrição Estadual (CCC) da UF do endereço
  stateRegistrationStatus String? // ex.: "Sem restrição"
  registryCheckedAt       DateTime? // quando o cadastro foi consultado na Receita/CCC

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vehicleOwnerships VehicleOwner[]
  serviceOrders     ServiceOrder[]

  @@unique([orgId, document])
  @@index([orgId])
}

model Vehicle {
  id        String   @id @default(cuid())
  orgId     String   @default(dbgenerated("app_org()")) @db.Uuid
  plate     String
  brand     String
  model     String
  year      Int?
  color     String?
  mileage   Int? // km at last known update
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Variante normalizada (marca > modelo > família > versão); null = não resolvida. Ver docs/specs/service-catalog.md §4.4
  variantId         String?
  variant           VehicleVariant?    @relation(fields: [variantId], references: [id], onDelete: SetNull)
  variantResolution VariantResolution?

  owners        VehicleOwner[]
  serviceOrders ServiceOrder[]

  @@unique([orgId, plate])
  @@index([orgId])
}

// Ownership history: current owner has endedAt = null.
// Application enforces exactly one open record per vehicle in a transaction.
model VehicleOwner {
  id         String    @id @default(cuid())
  orgId      String    @default(dbgenerated("app_org()")) @db.Uuid
  vehicleId  String
  customerId String
  startedAt  DateTime  @default(now())
  endedAt    DateTime?

  vehicle  Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  @@index([vehicleId, endedAt])
  @@index([orgId])
}

// ============================================================
// Catalogs: Parts (inventory) & Services (labor) — kept separate on purpose
// ============================================================

model Part {
  id           String  @id @default(cuid())
  orgId        String  @default(dbgenerated("app_org()")) @db.Uuid
  sku          String
  name         String
  costPrice    Decimal
  sellPrice    Decimal
  stockQty     Decimal @default(0)
  supplierName String?

  // Fiscal (NF-e/NFC-e). Nullable até a emissão ser ativada; o ideal é vir do XML da NF-e de entrada.
  ncm            String?
  cest           String?
  originCode     Int? // 0–8
  unit           String?
  defaultCfop    String?
  csosn          String? // Simples Nacional
  cst            String? // demais regimes
  fiscalVerified Boolean @default(false) // confirmado por contador; a emissão exige true

  ean String? // GTIN; o matcher da importação de NF-e casa o item da nota por aqui

  // Precificação (docs/specs/pricing.md §4.2). `costPrice` é o último custo; `avgCost` é o médio ponderado (só relatório).
  avgCost     Decimal?
  pricingMode PricingMode @default(AUTO) // MANUAL: nenhuma nota sugere nem altera o preço
  // Enquadramento tributário da venda (§5.2): sugerido pelo XML, confirmado pelo contador.
  icmsStStatus        IcmsStStatus @default(UNKNOWN)
  pisCofinsMonofasico Boolean?
  taxFlagsSource      TaxFlagsSource?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orderLines       ServiceOrderPartLine[]
  stockMovements   StockMovement[]
  supplierItemMaps SupplierItemMap[]
  invoiceItems     PurchaseInvoiceItem[]
  priceHistory     PartPriceHistory[]

  @@unique([orgId, sku])
  @@index([ean])
  @@index([orgId])
}

model Service {
  id               String   @id @default(cuid())
  orgId            String   @default(dbgenerated("app_org()")) @db.Uuid
  name             String // e.g. "Oil change", "Wheel alignment"
  description      String?
  estimatedMinutes Int? // fallback legado; a estimativa vem de ServiceEstimate (depreciado após a fase 2)
  defaultPrice     Decimal
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // null = serviço avulso: não gera observação nem estimativa
  definitionId    String?
  definition      ServiceDefinition?    @relation(fields: [definitionId], references: [id], onDelete: SetNull)
  pricingMode     ServicePricingMode    @default(FIXED)
  isSubcontracted Boolean               @default(false) // terceirizado (retífica, usinagem)
  fiscalProfileId String? // override do perfil herdado da definição
  fiscalProfile   ServiceFiscalProfile? @relation(fields: [fiscalProfileId], references: [id], onDelete: SetNull)

  orderLines ServiceOrderServiceLine[]

  @@unique([orgId, name])
  @@index([orgId])
}

enum ServicePricingMode {
  FIXED // defaultPrice
  HOURLY // horas × TenantFiscalSettings.hourlyRate
}

// ============================================================
// Service Orders
// ============================================================

enum ServiceOrderStatus {
  QUOTE // awaiting customer approval
  APPROVED
  IN_PROGRESS
  AWAITING_PART
  COMPLETED
  DELIVERED
  CANCELLED
}

model ServiceOrder {
  id             String             @id @default(cuid())
  orgId          String             @default(dbgenerated("app_org()")) @db.Uuid
  number         Int                @default(dbgenerated("next_org_seq('service_order'::text)")) // sequential number shown to the customer
  status         ServiceOrderStatus @default(QUOTE)
  description    String? // customer's initial complaint/request
  mileageAtEntry Int? // vehicle odometer at intake

  // Capability token do portal do cliente (/o/<token>): quem tem o link acessa a
  // ordem sem login. Alta entropia (24 bytes, base64url), gerado na criação.
  portalToken String @unique

  // Código curto (OS-XXXX-XXXX) que o portal pré-preenche na mensagem do wa.me. Ao chegar pelo
  // WhatsApp, o número do remetente (verificado pela Meta) é vinculado à ordem. Diferente do
  // portalToken: pode aparecer numa conversa, então só serve para vincular, nunca dá acesso ao portal.
  linkCode            String    @unique
  whatsappLinkedAt    DateTime?
  whatsappLinkedPhone String? // E.164 sem "+", do WhatsApp que se vinculou

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Restrict)

  createdById String
  createdBy   User   @relation("ServiceOrderCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  assignedToId String?
  assignedTo   User?   @relation("ServiceOrderAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)

  partLines    ServiceOrderPartLine[]
  serviceLines ServiceOrderServiceLine[]
  statusLogs   ServiceOrderStatusLog[]
  events       ServiceOrderEvent[]
  checklist    ServiceOrderChecklistItem[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  closedAt  DateTime?

  @@unique([orgId, number])
  @@index([orgId])
}

// Part line: stock is only debited when the order transitions QUOTE -> APPROVED
// (application rule, enforced in the service layer, not by the schema).
model ServiceOrderPartLine {
  id             String       @id @default(cuid())
  orgId          String       @default(dbgenerated("app_org()")) @db.Uuid
  serviceOrderId String
  serviceOrder   ServiceOrder @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)

  partId String
  part   Part   @relation(fields: [partId], references: [id], onDelete: Restrict)

  partName  String // snapshot of the part's name at time of sale
  quantity  Decimal @default(1)
  unitPrice Decimal // price charged on this order, frozen
  unitCost  Decimal? // custo médio da peça na saída do estoque (aprovação), congelado: base do lucro da OS. null = OS anterior à valorização

  stockMovements StockMovement[]

  createdAt DateTime @default(now())

  @@index([orgId])
}

model ServiceOrderServiceLine {
  id             String       @id @default(cuid())
  orgId          String       @default(dbgenerated("app_org()")) @db.Uuid
  serviceOrderId String
  serviceOrder   ServiceOrder @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)

  serviceId String
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  serviceName String // snapshot of the service's name at time of execution
  price       Decimal // price charged on this order, frozen

  // Texto livre → discriminação da NFS-e. NUNCA alimenta o aprendizado.
  description String?

  // Horas: estimativa exibida no orçamento e horas reais informadas na conclusão (spec §6)
  hoursEstimated      Decimal?
  hoursEstimateSource EstimateSource?
  hoursActual         Decimal?
  hoursActualSource   HoursSource?
  variantId           String? // snapshot do veículo no momento da execução
  variantResolution   VariantResolution?

  observation ServiceObservation?

  createdAt DateTime @default(now())

  @@index([orgId])
}

// Every status change is appended, never overwritten — audit trail for disputes.
model ServiceOrderStatusLog {
  id             String       @id @default(cuid())
  orgId          String       @default(dbgenerated("app_org()")) @db.Uuid
  serviceOrderId String
  serviceOrder   ServiceOrder @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)

  fromStatus  ServiceOrderStatus?
  toStatus    ServiceOrderStatus
  changedById String
  changedBy   User                @relation(fields: [changedById], references: [id], onDelete: Restrict)
  note        String?
  createdAt   DateTime            @default(now())

  @@index([orgId])
}

// ============================================================
// Portal do cliente: linha do tempo de eventos + checklist
// ============================================================

enum EventAuthor {
  CUSTOMER
  SHOP
  SYSTEM
}

enum EventType {
  MESSAGE // conversa entre cliente e oficina
  PROBLEM_REPORT // cliente descreveu o problema do carro
  STATUS_CHANGE // ordem mudou de status (gerado pelo sistema)
  CHECKLIST_UPDATE // item do checklist respondido/alterado
  CUSTOMER_DATA_UPDATE // cliente atualizou seus dados cadastrais
  WHATSAPP_LINK // WhatsApp do cliente vinculado à ordem (ou tentativa recusada)
}

// Toda a comunicação cliente <-> oficina acontece como eventos append-only, na
// ordem em que ocorreram. `data` guarda o payload estruturado de cada tipo
// (ex.: de/para do status, label e resultado do item de checklist).
model ServiceOrderEvent {
  id             String       @id @default(cuid())
  orgId          String       @default(dbgenerated("app_org()")) @db.Uuid
  serviceOrderId String
  serviceOrder   ServiceOrder @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)

  type         EventType
  author       EventAuthor
  authorUserId String? // preenchido quando author = SHOP
  authorName   String? // snapshot do nome exibido no momento do evento
  body         String?
  data         Json?
  createdAt    DateTime    @default(now())

  @@index([serviceOrderId, createdAt])
  @@index([orgId])
}

enum ChecklistStatus {
  PENDING
  OK
  ISSUE
}

model ServiceOrderChecklistItem {
  id             String       @id @default(cuid())
  orgId          String       @default(dbgenerated("app_org()")) @db.Uuid
  serviceOrderId String
  serviceOrder   ServiceOrder @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)

  section    String // agrupamento na UI, ex.: "Exterior", "Painel"
  label      String
  position   Int
  status     ChecklistStatus @default(PENDING)
  note       String?
  answeredAt DateTime?

  @@index([serviceOrderId, position])
  @@index([orgId])
}

// ============================================================
// Stock movements (append-only ledger backing Part.stockQty)
// ============================================================

enum StockMovementType {
  PURCHASE // inbound from supplier
  SALE_CONSUMPTION // outbound via ServiceOrder approval
  ADJUSTMENT // manual correction (inventory count, damage, loss)
  RETURN // part returned to stock (e.g. order cancelled after approval)
}

model StockMovement {
  id     String @id @default(cuid())
  orgId  String @default(dbgenerated("app_org()")) @db.Uuid
  partId String
  part   Part   @relation(fields: [partId], references: [id], onDelete: Restrict)

  type         StockMovementType
  quantity     Decimal // always positive; direction comes from `type`
  balanceAfter Decimal // Part.stockQty right after this movement, for audit

  serviceOrderPartLineId String?
  serviceOrderPartLine   ServiceOrderPartLine? @relation(fields: [serviceOrderPartLineId], references: [id], onDelete: SetNull)

  note        String? // reason, purchase invoice number, etc.
  createdById String
  createdBy   User    @relation(fields: [createdById], references: [id], onDelete: Restrict)

  // Entrada por NF-e (docs/specs/nfe-import.md §8.3). Idempotência: no máximo um PURCHASE e um
  // ADJUSTMENT (estorno) por item de nota. NULLs são distintos no Postgres, então os demais
  // movimentos não são afetados.
  purchaseInvoiceItemId String?
  purchaseInvoiceItem   PurchaseInvoiceItem? @relation(fields: [purchaseInvoiceItemId], references: [id], onDelete: Restrict)

  // Valorização (kardex): o custo deste movimento e o custo médio antes e depois. Entrada por nota = custo líquido de
  // reposição; saída e devolução = custo médio do momento. null = movimento sem custo conhecido (anterior à valorização,
  // ou entrada manual sem custo).
  unitCost      Decimal?
  avgCostBefore Decimal?
  avgCostAfter  Decimal?

  entrySnapshot StockEntrySnapshot?

  createdAt DateTime @default(now())

  @@unique([purchaseInvoiceItemId, type])
  @@index([orgId])
}

// Fotografia imutável de uma entrada no estoque por nota (docs/specs/stock-entry-snapshot.md): tudo o que o custo e o preço
// usaram naquele instante, para explicar e reproduzir o lançamento depois que a peça, o perfil ou as tabelas mudarem.
// Uma por movimento PURCHASE de nota. Gravada na mesma transação do lançamento; UPDATE é recusado por trigger.
model StockEntrySnapshot {
  id                    String        @id @default(cuid())
  orgId                 String        @default(dbgenerated("app_org()")) @db.Uuid
  stockMovementId       String        @unique
  stockMovement         StockMovement @relation(fields: [stockMovementId], references: [id], onDelete: Restrict)
  partId                String
  purchaseInvoiceItemId String
  schemaVersion         Int // formato de `context`; muda quando um campo novo passa a ser obrigatório
  // Colunas para consulta e relatório; o resto está em `context`.
  quantity              Decimal // unidades de estoque que entraram
  unitCost              Decimal // custo líquido de reposição por unidade
  totalCost             Decimal
  avgCostAfter          Decimal
  sellPriceAfter        Decimal // preço de venda depois do lançamento (igual ao anterior se o preço não mudou)
  priceChanged          Boolean
  taxRulesVersion       String // versão de packages/tax-rules
  rulesetVersion        String? // tax-engine (platform), quando o Fixer passar a consumi-lo
  costProfileVersion    Int? // cost-engine (platform), idem
  context               Json // documento, componentes do custo, preço, imposto, regra, perfil, aceites
  contentHash           String // sha256 do `context` canônico: evidência de que não foi alterado
  createdById           String
  createdAt             DateTime      @default(now())

  @@index([partId, createdAt])
  @@index([purchaseInvoiceItemId])
  @@index([orgId])
}

// ============================================================
// Outbox transacional (integração com serviços desacoplados)
// ============================================================

// Mudanças em ordens de serviço são gravadas aqui NA MESMA TRANSAÇÃO da mudança
// (garantia: se a ordem mudou, o evento existe; se rolou back, não existe).
// O OutboxRelay da API publica as linhas pendentes no Redis Stream e marca
// `publishedAt`. Consumidores (ex.: apps/notifications) só conhecem o envelope
// publicado, nunca esta tabela. `payload` é o envelope v1 completo.
// Inbox do consumidor de eventos que chegam de outros serviços (ex.: whatsapp.order_code_received).
// A PK é o id do evento: reentrega (at-least-once) cai no conflito e vira no-op, na mesma
// transação que aplica o efeito.
model ProcessedInboundEvent {
  id          String   @id // id do evento (UUID gerado por quem publicou)
  orgId       String   @default(dbgenerated("app_org()")) @db.Uuid
  type        String
  processedAt DateTime @default(now())

  @@index([processedAt])
  @@index([orgId])
}

model OutboxEvent {
  id            String    @id @default(uuid())
  orgId         String    @default(dbgenerated("app_org()")) @db.Uuid
  seq           BigInt    @unique @default(autoincrement()) // ordem global de emissão
  type          String // ex.: "order.status_changed"
  aggregateType String // ex.: "service_order"
  aggregateId   String
  payload       Json
  createdAt     DateTime  @default(now())
  publishedAt   DateTime?

  @@index([publishedAt, seq])
  @@index([orgId])
}

// ============================================================
// Catálogo de serviços, fiscal e aprendizado de tempos
// Spec: docs/specs/service-catalog.md
// ============================================================

enum CatalogOrigin {
  GLOBAL // vem do packages/catalog
  LOCAL // criado neste tenant
}

enum ServiceAction {
  SUBSTITUIR
  REVISAR
  REGULAR
  DIAGNOSTICAR
  LIMPAR
  REPARAR
  INSTALAR
  REMOVER
}

enum VariantLevel {
  MAKE
  MODEL
  FAMILY
  VERSION
}

enum VariantResolution {
  FIPE
  FAMILY
  MODEL
  MAKE
  NONE
}

enum EstimateSource {
  LEARNED // nó com n >= N_MIN: pré-preenche
  REFERENCE // 1 <= n < N_MIN: só exibe
  MANUAL // usuário digitou
  NONE // sem histórico
}

enum HoursSource {
  MEASURED // reservado (cronômetro, fora da v1)
  EDITED
  ACCEPTED_DEFAULT
}

enum TaxRegime {
  SIMPLES
  PRESUMIDO
  REAL
}

// Árvore de sistemas/componentes: Transmissão > Embreagem > Kit de embreagem
model VehicleComponent {
  id       String             @id @default(cuid())
  code     String             @unique // "EMBREAGEM_KIT" — estável
  name     String
  parentId String?
  parent   VehicleComponent?  @relation("ComponentTree", fields: [parentId], references: [id], onDelete: Restrict)
  children VehicleComponent[] @relation("ComponentTree")

  definitions ServiceDefinition[]
}

model ServiceFiscalProfile {
  id          String  @id @default(cuid())
  code        String  @unique // "LC116_14_01"
  lc116Item   String // "14.01"
  nbs         String? // default em spec §4.3.1
  cnae        String?
  issWithheld Boolean @default(false)
  verified    Boolean @default(false) // confirmado por contador; a emissão exige true
  // Alíquota de ISS e código de tributação municipal NÃO ficam aqui: dependem do município (TenantFiscalSettings).

  definitions ServiceDefinition[]
  services    Service[]
}

model ServiceDefinition {
  id               String                @id @default(cuid())
  code             String                @unique // "SUBSTITUIR:EMBREAGEM_KIT"
  action           ServiceAction
  componentId      String
  component        VehicleComponent      @relation(fields: [componentId], references: [id], onDelete: Restrict)
  nfseTextTemplate String?
  fiscalProfileId  String?
  fiscalProfile    ServiceFiscalProfile? @relation(fields: [fiscalProfileId], references: [id], onDelete: SetNull)
  origin           CatalogOrigin         @default(GLOBAL)
  catalogVersion   String?
  deprecatedAt     DateTime? // nunca DELETE: há OS referenciando

  services       Service[]
  suggestedParts ServiceSuggestedPart[]
  estimates      ServiceEstimate[]
  observations   ServiceObservation[]

  @@unique([action, componentId])
}

model VehicleVariant {
  id       String           @id @default(cuid())
  level    VariantLevel
  key      String           @unique // determinístico: "fiat/palio/1.0/flex", "fipe:001267-0"
  parentId String?
  parent   VehicleVariant?  @relation("VariantTree", fields: [parentId], references: [id], onDelete: Restrict)
  children VehicleVariant[] @relation("VariantTree")

  make     String
  model    String?
  engine   String? // litros, "1.0"
  fuel     String?
  fipeCode String? // só em VERSION
  origin   CatalogOrigin @default(GLOBAL)

  vehicles     Vehicle[]
  estimates    ServiceEstimate[]
  observations ServiceObservation[]

  @@index([parentId])
}

// Fonte da verdade do aprendizado. unique(serviceLineId) garante idempotência.
model ServiceObservation {
  id                  String                  @id @default(cuid())
  orgId               String                  @default(dbgenerated("app_org()")) @db.Uuid
  serviceLineId       String                  @unique
  serviceLine         ServiceOrderServiceLine @relation(fields: [serviceLineId], references: [id], onDelete: Cascade)
  serviceDefinitionId String
  serviceDefinition   ServiceDefinition       @relation(fields: [serviceDefinitionId], references: [id], onDelete: Restrict)
  variantId           String
  variant             VehicleVariant          @relation(fields: [variantId], references: [id], onDelete: Restrict)
  hoursActual         Decimal
  weight              Decimal                 @default(1) // 1 editado/medido; 0.25 aceito sem edição
  observedAt          DateTime
  excluded            Boolean                 @default(false)
  excludedReason      String?

  @@index([serviceDefinitionId, variantId])
  @@index([orgId])
}

// Agregado recalculável: função pura das observações (spec §6.4).
model ServiceEstimate {
  id                  String            @id @default(cuid())
  orgId               String            @default(dbgenerated("app_org()")) @db.Uuid
  serviceDefinitionId String
  serviceDefinition   ServiceDefinition @relation(fields: [serviceDefinitionId], references: [id], onDelete: Cascade)
  variantId           String
  variant             VehicleVariant    @relation(fields: [variantId], references: [id], onDelete: Cascade)
  hoursMedian         Decimal
  hoursP25            Decimal
  hoursP75            Decimal
  sampleCount         Int
  computedAt          DateTime
  inputsDigest        String // hash das observações usadas; igual = não regrava

  @@unique([orgId, serviceDefinitionId, variantId])
  @@index([orgId])
}

model ServiceSuggestedPart {
  id                  String            @id @default(cuid())
  serviceDefinitionId String
  serviceDefinition   ServiceDefinition @relation(fields: [serviceDefinitionId], references: [id], onDelete: Cascade)
  variantKey          String? // null = vale para qualquer veículo
  partCategory        String // "DISCO_EMBREAGEM"
  quantity            Decimal           @default(1)
  optional            Boolean           @default(false)

  @@unique([serviceDefinitionId, variantKey, partCategory])
}

// Singleton por tenant (1 banco = 1 oficina).
model TenantFiscalSettings {
  orgId                String     @id @default(dbgenerated("app_org()")) @db.Uuid
  cnpj                 String? // 14 caracteres alfanuméricos [A-Z0-9]{12}[0-9]{2}, sem máscara (nfe-import.md D12)
  legalName            String?
  ufCode               Int? // cUFAutor (código IBGE da UF)
  municipalityIbge     String?
  taxRegime            TaxRegime?
  issRate              Decimal?
  municipalServiceCode String?
  hourlyRate           Decimal?
  cnae                 String? // CNAE principal (7 dígitos), da consulta de CNPJ
  lc116Item            String? // serviço padrão da oficina na LC 116 ("14.01"), inferido da CNAE (docs/specs/fiscal-autofill.md §5.1)

  @@map("tenant_fiscal_settings")
}

// De onde veio cada valor da configuração fiscal (docs/specs/fiscal-autofill.md §4). Valor MANUAL nunca é trocado sozinho.
enum FiscalValueSource {
  CNPJ_LOOKUP
  INTEGRA_PGDASD
  INTEGRA_PAGAMENTOS
  NFSE_PARAMETROS
  TAX_RULES_DEFAULT
  FIXER_ESTIMATE
  MANUAL
}

enum FiscalValueConfidence {
  OFICIAL // registro do próprio governo
  INFERIDO // deduzido de dado oficial por regra do Fixer
  ESTIMADO // sem fonte oficial
  INFORMADO // digitado por alguém (fonte MANUAL)
}

// Um registro por campo: a origem do valor em uso. Também guarda fatos sem coluna própria (ex.: "simplesOptant").
model FiscalFieldProvenance {
  orgId      String                @default(dbgenerated("app_org()")) @db.Uuid
  field      String
  source     FiscalValueSource
  confidence FiscalValueConfidence
  fetchedAt  DateTime              @default(now())
  reference  String? // ex.: CNAE consultada, período de apuração
  evidence   Json? // resumo do que a fonte respondeu; nunca documento inteiro
  updatedBy  String? // userId quando MANUAL

  @@id([orgId, field])
  @@map("fiscal_field_provenance")
}

// Singleton: versão do packages/catalog aplicada neste banco.
model CatalogState {
  id        Int      @id @default(1)
  version   String
  appliedAt DateTime

  @@map("catalog_state")
}

// ============================================================
// Importação de NF-e de compra (docs/specs/nfe-import.md)
// ============================================================

enum FiscalEnvironment {
  PRODUCTION
  HOMOLOGATION
}

// Singleton. O .pfx e a senha NUNCA saem do banco em claro nem pela API (envelope AES-256-GCM, §7.2).
model FiscalCredential {
  orgId       String            @id @default(dbgenerated("app_org()")) @db.Uuid
  environment FiscalEnvironment @default(PRODUCTION)

  pfxCiphertext     Bytes
  pfxPassCiphertext Bytes
  keyId             String // qual chave mestra cifrou (rotação)

  subject    String // CN do certificado, só para exibição
  certCnpj   String // CNPJ extraído do certificado (OID 2.16.76.1.3.3)
  notBefore  DateTime
  notAfter   DateTime
  mirroredAt DateTime? // última confirmação do estado com o dfe-gateway (null = nunca / modo direto)

  enabled        Boolean @default(false) // liga/desliga a sincronização
  autoManifest   Boolean @default(false) // consente a Ciência da Operação automática
  autoExport     Boolean @default(false) // dá entrada sem confirmação quando 100% resolvido
  autoExportById String? // autor dos movimentos automáticos (StockMovement.createdById é obrigatório)
  autoExportBy   User?   @relation("FiscalAutoExportBy", fields: [autoExportById], references: [id], onDelete: Restrict)

  uploadedById String
  uploadedBy   User     @relation("FiscalUploadedBy", fields: [uploadedById], references: [id], onDelete: Restrict)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  syncState FiscalSyncState?
}

model FiscalSyncState {
  orgId      String           @id @default(dbgenerated("app_org()")) @db.Uuid
  credential FiscalCredential @relation(fields: [orgId], references: [orgId], onDelete: Cascade)

  lastNsu             BigInt    @default(0) // último NSU consumido (até 15 dígitos)
  maxNsu              BigInt    @default(0)
  nextPollAt          DateTime  @default(now())
  leaseUntil          DateTime?
  leaseOwner          String?
  consecutiveFailures Int       @default(0)
  lastStatusCode      Int? // último cStat da SEFAZ
  lastError           String?
  lastRunAt           DateTime?
  lastSuccessAt       DateTime?
}

model FiscalAuditLog {
  id     String   @id @default(cuid())
  orgId  String   @default(dbgenerated("app_org()")) @db.Uuid
  at     DateTime @default(now())
  userId String
  user   User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  action String // ex.: "credential.upload", "credential.delete", "flags.update"
  detail Json? // nunca contém segredo
  ip     String?

  @@index([at])
  @@index([orgId])
}

// Ciclo fiscal: o que a SEFAZ entregou.
enum PurchaseInvoiceStatus {
  SUMMARY // só o resumo (resNFe); falta ciência para vir o XML completo
  MANIFESTED // ciência enviada; aguardando o procNFe
  FULL // XML completo guardado e itens extraídos
  CANCELED // evento de cancelamento recebido
  IGNORED // não é compra para este CNPJ, ou XML inválido
}

// Ciclo de estoque: o que foi feito com a nota.
enum InvoiceExportStatus {
  NOT_READY // ainda sem XML completo
  PENDING_MATCH // há item sem vínculo, ou a nota exige revisão
  READY // 100% resolvida, aguardando confirmação (ou autoExport)
  POSTED // entrada lançada no estoque
  VOIDED // cancelada antes da entrada, ou entrada estornada
}

model PurchaseInvoice {
  id            String    @id @default(cuid())
  orgId         String    @default(dbgenerated("app_org()")) @db.Uuid
  accessKey     String // 44 caracteres alfanuméricos
  nsu           BigInt? // facultativo na NT
  series        Int?
  number        Int?
  issuedAt      DateTime?
  issuerCnpj    String // 14 alfanuméricos; CPF (11 dígitos) em produtor rural
  issuerName    String
  recipientCnpj String?
  totalAmount   Decimal
  finality      Int? // finNFe: 1 normal, 2 compl., 3 ajuste, 4 devolução
  operationType Int? // tpNF: 1 = saída do emitente

  status           PurchaseInvoiceStatus @default(SUMMARY)
  manifestedAt     DateTime?
  // Ciência da Operação (nfe-import.md §6.4): tentativas e último erro, para backoff e para a UI mostrar a falha.
  manifestAttempts Int                   @default(0)
  manifestError    String?
  manifestNextAt   DateTime?
  canceledAt       DateTime?
  ignoredReason    String?

  xmlGz     Bytes? // procNFe original, gzip. Guarda fiscal: nunca apagar
  xmlSha256 String?

  exportStatus InvoiceExportStatus @default(NOT_READY)
  needsReview  Boolean             @default(false) // finalidade ≠ 1 ou outro motivo: nunca READY automático
  postedAt     DateTime?
  postedById   String?
  postedBy     User?               @relation("InvoicePostedBy", fields: [postedById], references: [id], onDelete: Restrict)

  // Captura tributária do XML (docs/specs/pricing.md §4.0). Tudo nullable: notas antigas são preenchidas pelo backfill.
  issuerCrt     Int? // emit/CRT: 1 Simples, 2 Simples (excesso de sublimite), 3 regime normal, 4 MEI
  issuerUf      String? // emit/enderEmit/UF
  recipientUf   String? // dest/enderDest/UF
  destIndicator Int? // ide/idDest: 1 interna, 2 interestadual, 3 exterior
  freightMode   Int? // transp/modFrete: 0 emitente (CIF), 1 destinatário (FOB), 2 terceiros, 3/4 próprio, 9 sem frete
  totals        Json? // ICMSTot como string: vProd, vDesc, vFrete, vSeg, vOutro, vICMS, vST, vFCPST, vIPI, vPIS, vCOFINS
  extraFreight  Decimal? // "frete por fora" informado à mão (CT-e à parte), rateado por vProd no custo

  receivedAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  items    PurchaseInvoiceItem[]
  payables Payable[]

  @@unique([orgId, accessKey])
  @@index([exportStatus])
  @@index([status, manifestNextAt])
  @@index([issuedAt])
  @@index([orgId])
}

enum ItemResolution {
  UNRESOLVED
  AUTO_MAP // casou por SupplierItemMap
  AUTO_EAN // casou por Part.ean
  MANUAL // escolhido pelo usuário
  IGNORED // não é estoque (uso e consumo, brinde, frete)
}

model PurchaseInvoiceItem {
  id           String          @id @default(cuid())
  orgId        String          @default(dbgenerated("app_org()")) @db.Uuid
  invoiceId    String
  invoice      PurchaseInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  itemNumber   Int // nItem
  supplierCode String // cProd
  ean          String? // cEAN / cEANTrib válido (≠ "SEM GTIN")
  description  String // xProd
  ncm          String
  cest         String?
  origin       Int? // orig (0–8)
  cfop         String
  unit         String // uCom
  quantity     Decimal // qCom
  unitPrice    Decimal // vUnCom
  totalPrice   Decimal // vProd
  discount     Decimal         @default(0) // vDesc
  freight      Decimal         @default(0) // vFrete
  insurance    Decimal         @default(0) // vSeg
  otherCosts   Decimal         @default(0) // vOutro
  ipi          Decimal         @default(0) // vIPI
  icmsSt       Decimal         @default(0) // vICMSST

  resolution ItemResolution @default(UNRESOLVED)
  partId     String?
  part       Part?          @relation(fields: [partId], references: [id], onDelete: Restrict)
  unitFactor Decimal        @default(1) // unidades de estoque por unidade da nota (caixa de 4 = 4)

  stockMovements StockMovement[]
  tax            PurchaseInvoiceItemTax?

  // Rascunho de precificação (docs/specs/pricing.md §4.2): sobrevive a recarregar a página.
  suggestedSellPrice Decimal? // o que a regra sugeriu no último cálculo
  draftSellPrice     Decimal? // o que a pessoa escolheu (null = aceitar a sugestão)
  pricingRuleId      String?
  priceAck           Boolean  @default(false) // "estou ciente" de alerta que bloqueia o lançamento
  appliedSellPrice   Decimal? // preenchido no lançamento: o que foi de fato aplicado
  costSnapshot       Json? // livro de custo do último cálculo
  saleTaxSnapshot    Json? // perfil de imposto sobre a venda do último cálculo

  @@unique([invoiceId, itemNumber])
  @@index([supplierCode])
  @@index([orgId])
}

enum PricingMethod {
  MARGIN // margem sobre a venda
  MARKUP // markup sobre o custo
}

enum PricingScope {
  DEFAULT
  SUPPLIER
  NCM
  PART
}

enum RoundingMode {
  NONE
  CENTS_90
  CENTS_00
  MULTIPLE_5
  MULTIPLE_10
}

enum PricingMode {
  AUTO
  MANUAL
}

enum IcmsStStatus {
  UNKNOWN
  NOT_ST
  ST_CHARGED // ST cobrada na compra
  ST_PAID_BEFORE // ST já retida antes (CST 60 / CSOSN 500)
}

enum TaxFlagsSource {
  XML
  TABELA
  MANUAL
}

enum PriceChangeSource {
  INVOICE
  MANUAL
  AUTO
  REVERSAL
}

// Regra de preço da oficina (docs/specs/pricing.md §4.1). Na fase 1 só existe a regra DEFAULT.
model PricingRule {
  id             String        @id @default(cuid())
  orgId          String        @default(dbgenerated("app_org()")) @db.Uuid
  scope          PricingScope
  scopeKey       String        @default("") // CNPJ do fornecedor, prefixo de NCM ou partId; "" para DEFAULT
  method         PricingMethod @default(MARGIN)
  value          Decimal // % (35 = 35%)
  taxPctOverride Decimal? // % de imposto s/ venda definido pela oficina; null = calculado do perfil tributário
  overheadPct    Decimal       @default(0) // % do preço de despesa variável (taxa de cartão...)
  rounding       RoundingMode  @default(CENTS_90)
  minMarginPct   Decimal       @default(0) // abaixo disso o confirmar exige ciência
  maxJumpPct     Decimal       @default(25) // variação máxima de preço sem confirmação explícita
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([orgId, scope, scopeKey])
  @@index([orgId])
}

// Perfil tributário da oficina para precificar (docs/specs/pricing.md §4.1.1). Singleton por organização.
// Os percentuais são informados pelo contador: o sistema não traz alíquota nenhuma por padrão.
model TenantTaxProfile {
  orgId                   String    @id @default(dbgenerated("app_org()")) @db.Uuid
  rbt12                   Decimal? // receita bruta dos últimos 12 meses; com ela a alíquota efetiva vem do Anexo I (packages/tax-rules)
  rbt12AsOf               DateTime? // data de referência da RBT12 informada
  icmsSalePct             Decimal? // alíquota de ICMS que a oficina cobra na venda (Lucro Presumido): o ICMS é estadual e não vem de tabela federal
  simplesEffectiveRatePct Decimal? // override manual da alíquota efetiva (vale mais que a calculada da RBT12)
  icmsSharePct            Decimal? // parte da alíquota efetiva que é ICMS (% da própria alíquota efetiva)
  pisSharePct             Decimal?
  cofinsSharePct          Decimal?
  requireTaxConfirmation  Boolean   @default(false) // item com imposto "estimado" exige ciência
  stateTaxRegular         Boolean? // em dia com a SEFAZ estadual (PE: RICMS art. 393-A); muda o percentual da antecipação na entrada. null = não informado (o custo usa o pior caso)
  reviewedBy              String? // quem validou (contador)
  reviewedAt              DateTime?
  updatedAt               DateTime  @updatedAt

  @@map("tenant_tax_profile")
}

// O que o motor de custos (platform cost-engine) precisa e o Fixer não registra sozinho (docs/specs/cost-engine.md §14, fase 1):
// mix de pagamento, horas disponíveis da oficina e meta de faturamento. Singleton por organização.
model CostSettings {
  orgId                String    @id @default(dbgenerated("app_org()")) @db.Uuid
  paymentMix           Json? // % por forma de pagamento: { "PIX": 30, "DINHEIRO": 10, "DEBITO": 10, "CREDITO_1X": 25, "CREDITO_PARCELADO": 25 }
  mechanics            Int? // pessoas que vendem horas na oficina
  hoursPerMechanic     Decimal? // horas de trabalho por pessoa no mês
  partsRevenueGoal     Decimal? // meta mensal de faturamento de peças: base do rateio enquanto não há 3 meses de histórico
  templateApplied      Boolean   @default(false) // a empresa já recebeu o modelo "oficina" no cost-engine
  lastSyncAt           DateTime?
  lastPublishedVersion Int?
  updatedAt            DateTime  @updatedAt

  @@map("cost_settings")
}

// Aceite do contador por tabela de regra tributária (packages/tax-rules): a versão que ele validou. Mudou a versão da tabela,
// o aceite deixa de valer e o imposto volta a "estimado".
model TaxTableReview {
  orgId      String   @default(dbgenerated("app_org()")) @db.Uuid
  tableId    String
  version    String
  reviewedBy String
  reviewedAt DateTime @default(now())

  @@id([orgId, tableId])
  @@map("tax_table_review")
}

model PartPriceHistory {
  id                    String            @id @default(cuid())
  orgId                 String            @default(dbgenerated("app_org()")) @db.Uuid
  partId                String
  part                  Part              @relation(fields: [partId], references: [id], onDelete: Restrict)
  costBefore            Decimal?
  costAfter             Decimal
  sellBefore            Decimal?
  sellAfter             Decimal
  marginAfter           Decimal? // % líquida sobre a venda no momento
  saleTaxPct            Decimal?
  costBreakdown         Json?
  saleTaxBreakdown      Json?
  taxRulesVersion       String?
  source                PriceChangeSource
  purchaseInvoiceItemId String?
  pricingRuleId         String?
  createdById           String
  createdAt             DateTime          @default(now())

  @@unique([purchaseInvoiceItemId, source])
  @@index([partId, createdAt])
  @@index([orgId])
}

// Campos tributários do item como vieram no XML (docs/specs/pricing.md §4.0). Alimentam o livro de custo
// (apps/api/src/fiscal-inbound/tax) e, mais adiante, o imposto sobre a venda. Strings decimais viram Decimal aqui.
model PurchaseInvoiceItemTax {
  id        String              @id @default(cuid())
  orgId     String              @default(dbgenerated("app_org()")) @db.Uuid
  itemId    String              @unique
  item      PurchaseInvoiceItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  indTot    Int? // 0 = o item não compõe o total da nota
  icmsKind  String? // 'CST' | 'CSOSN'
  icmsCode  String? // 00, 10, 60, 101, 500...
  icmsBase  Decimal? // vBC
  icmsRate  Decimal? // pICMS
  icms      Decimal? // vICMS
  stBase    Decimal? // vBCST
  stRate    Decimal? // pICMSST
  icmsSt    Decimal? // vICMSST
  fcpSt     Decimal? // vFCPST
  stRet     Decimal? // vICMSSTRet (ST já retido numa etapa anterior)
  fcpStRet  Decimal? // vFCPSTRet
  deson     Decimal? // vICMSDeson
  creditSnRate Decimal? // pCredSN (emitente Simples)
  creditSn  Decimal? // vCredICMSSN
  ipiCst    String?
  pisCst    String? // 02/03/04 indicam PIS monofásico
  pis       Decimal?
  cofinsCst String?
  cofins    Decimal?
  ibsCbs    Json? // grupo IBSCBS (NT 2025.002) cru; ainda não entra no cálculo

  @@index([orgId])
}

// Vínculo aprendido: o próximo item do mesmo fornecedor/código resolve sozinho.
model SupplierItemMap {
  id           String   @id @default(cuid())
  orgId        String   @default(dbgenerated("app_org()")) @db.Uuid
  supplierCnpj String
  supplierCode String
  partId       String
  part         Part     @relation(fields: [partId], references: [id], onDelete: Restrict)
  unitFactor   Decimal  @default(1)
  createdAt    DateTime @default(now())
  lastUsedAt   DateTime @default(now())

  @@unique([orgId, supplierCnpj, supplierCode])
  @@index([orgId])
}

// Contadores por organização (ex.: numeração das ordens de serviço). Usado por next_org_seq(); a API não acessa direto.
model OrgCounter {
  orgId String @default(dbgenerated("app_org()")) @db.Uuid
  name  String
  value Int

  @@id([orgId, name])
}

// ============================================================
// Provisionamento e licença (alimentados pelos eventos do control plane)
// ============================================================

// Dados da organização enviados pelo control plane ao criá-la. O dono vira Admin no primeiro login.
model OrgProfile {
  orgId      String   @id @default(dbgenerated("app_org()")) @db.Uuid
  slug       String?
  name       String? // razão social, para o seletor de organização
  ownerEmail String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// Último estado de licença conhecido (snapshot assinado do control plane). Sem linha = sem restrição (instalação legada).
// mode: full | readonly | none (docs/specs/control-plane.md §5).
model OrgLicense {
  orgId         String    @id @default(dbgenerated("app_org()")) @db.Uuid
  status        String
  mode          String
  version       Int
  trialEndsAt   DateTime?
  readonlyUntil DateTime?
  entitlements  Json      @default("{}")
  refreshedAt   DateTime  @default(now())
}

// Quem participa de qual organização (alimentado pelos eventos de identidade do control plane). Fonte de verdade da
// participação: o claim "organization" do Keycloak 26.0 é intermitente para quem está em várias organizações.
model OrgMembership {
  orgId      String   @default(dbgenerated("app_org()")) @db.Uuid
  keycloakId String // sub do token
  email      String
  role       String   @default("member")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@id([orgId, keycloakId])
  @@index([keycloakId])
}

// ============================================================
// Contas a pagar
// ============================================================

enum PayableStatus {
  OPEN // a pagar (vencida ou não: o atraso é derivado da data)
  PAID
  CANCELED // nota cancelada pelo fornecedor, ou lançamento manual descartado
}

enum PayableSource {
  XML_INSTALLMENT // duplicata (cobr/dup) da NF-e
  XML_TOTAL // nota sem duplicatas: uma parcela com o valor declarado, vencimento na emissão
  MANUAL
}

// Uma parcela a pagar. Nasce sozinha das duplicatas do XML da NF-e (invoiceId preenchido) ou é lançada à mão.
model Payable {
  id               String           @id @default(cuid())
  orgId            String           @default(dbgenerated("app_org()")) @db.Uuid
  invoiceId        String?
  invoice          PurchaseInvoice? @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  source           PayableSource
  supplierCnpj     String?
  supplierName     String
  description      String?
  category         String? // classificação da despesa (texto livre com sugestões)
  barcode          String? // linha digitável do boleto (só dígitos)
  documentNumber   String? // nDup, ou o número da nota quando a parcela não é numerada
  installment      Int              @default(1)
  installmentCount Int              @default(1)
  dueDate          DateTime         @db.Date
  amount           Decimal          @db.Decimal(14, 2)
  status           PayableStatus    @default(OPEN)
  paidAt           DateTime?
  paidAmount       Decimal?         @db.Decimal(14, 2) // = amount + interest - discount
  interest         Decimal?         @db.Decimal(14, 2) // juros e multa pagos
  discount         Decimal?         @db.Decimal(14, 2) // desconto obtido
  paymentMethod    String?
  paidById         String?
  paidBy           User?            @relation("PayablePaidBy", fields: [paidById], references: [id], onDelete: Restrict)
  events           PayableEvent[]
  notes            String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@unique([orgId, invoiceId, installment])
  @@index([orgId])
  @@index([status, dueDate])
  @@index([supplierCnpj])
}

// Trilha de auditoria de uma conta: quem fez o quê e quando (pagamento, estorno, edição, cancelamento).
model PayableEvent {
  id        String   @id @default(cuid())
  orgId     String   @default(dbgenerated("app_org()")) @db.Uuid
  payableId String
  payable   Payable  @relation(fields: [payableId], references: [id], onDelete: Cascade)
  type      String // CREATED | EDITED | PAID | UNPAID | CANCELED
  actorId   String?
  actorName String?
  data      Json?
  createdAt DateTime @default(now())

  @@index([orgId])
  @@index([payableId, createdAt])
}
